DB_CONNECTION_STRING=mongodb+srv://user:password@host
DB_NAME=

# Account to crawl
IG_USERNAME=

S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com/<bucket>
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_DEV_ACCESS_URL=https://pub-xxxx.r2.dev

# Abort if a run would delete more than this fraction of stored posts
MAX_DELETE_RATIO=0.5
